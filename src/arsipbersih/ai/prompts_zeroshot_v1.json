      {"prompt": "a landscape photo", "sub": "pemandangan"},
      {"prompt": "a photo of mountains", "sub": "gunung"},
      {"prompt": "a photo of the beach", "sub": "pantai"},
      {"prompt": "a photo of a city street", "sub": "jalan"},
      {"prompt": "a photo of food", "sub": "makanan"},
      {"prompt": "a photo of a building", "sub": "bangunan"},
      {"prompt": "a photo of nature", "sub": "alam"},
      {"prompt": "a photo of an event", "sub": "acara"},
      {"prompt": "a photo of a room", "sub": "ruangan"},
      {"prompt": "a photo of an animal", "sub": "hewan"},
      {"prompt": "a photo taken while hiking", "sub": "mendaki"},
      {"prompt": "a photo of a vehicle", "sub": "kendaraan"},
      {"prompt": "a photo of the sky", "sub": "langit"},
      {"prompt": "a blurry photo", "sub": "buram"},
